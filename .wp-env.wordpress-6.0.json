{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": "WordPress/WordPress#6.0",
  "plugins": [
    "./deploy-and-test"
  ],
  "mappings": {
    "wp-content/plugins/deploy-and-test/phpunit.xml.dist": "./phpunit.xml.dist",
    "wp-content/plugins/deploy-and-test/tests": "./tests",
    "wp-content/plugins/deploy-and-test/vendor": "./vendor"
  },
  "port": 8891,
  "testsEnvironment": false,
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false
  }
}
