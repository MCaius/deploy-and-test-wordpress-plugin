{
  "name": "deploy-and-test-wordpress-plugin",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "build:zip": "node scripts/build-zip.mjs",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:status": "wp-env status",
    "env:reset": "wp-env reset all",
    "env:destroy": "wp-env destroy",
    "env:test:start": "wp-env --config=.wp-env.test.json start",
    "env:test:stop": "wp-env --config=.wp-env.test.json stop",
    "env:test:status": "wp-env --config=.wp-env.test.json status",
    "env:e2e:start": "wp-env --config=.wp-env.e2e.json start",
    "env:e2e:stop": "wp-env --config=.wp-env.e2e.json stop",
    "env:e2e:status": "wp-env --config=.wp-env.e2e.json status",
    "test:php": "wp-env --config=.wp-env.test.json run cli php wp-content/plugins/deploy-and-test/vendor/bin/phpunit -c wp-content/plugins/deploy-and-test/phpunit.xml.dist --do-not-cache-result",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@wordpress/env": "11.12.0"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "brace-expansion": "2.1.4",
    "fast-uri": "3.1.5"
  }
}
